{
  "manifest_version": 3,
  "name": "TUNTAS SE2026 - Tracking dan Tindak Lanjut Anomali Sensus",
  "version": "1.0.0",
  "description": "TUNTAS SE2026: otomasi pembukaan link FASIH-SM dari Excel, pengisian catatan #DC_00 untuk semua rincian usaha, dan kirim survei.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TUNTAS SE2026"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://fasih-sm.bps.go.id/*",
    "https://*.bps.go.id/*",
    "*://*.bps.go.id/*",
    "https://n8n7309.online/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fasih-sm.bps.go.id/*",
        "https://*.bps.go.id/*",
        "*://*.bps.go.id/*"
      ],
      "js": [
        "content/fasih_api.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
